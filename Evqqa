async def daily_report():
    while True:
        now = datetime.now()
        target = now.replace(hour=23, minute=0, second=0, microsecond=0)
        if now > target:
            target += timedelta(days=1)
        await asyncio.sleep((target - now).seconds)
        
        if eva_messages_log:
            report = "📊 **ОТЧЁТ ЗА ДЕНЬ**\n\n" + "\n".join(eva_messages_log[-50:])
            await bot.send_message(YOUR_TELEGRAM_ID, report[:4000])
        else:
            await bot.send_message(YOUR_TELEGRAM_ID, "📊 За сегодня Ева ничего не писала. Странно.")
        
        eva_messages_log.clear()

# === ЗАПУСК ===
async def main():
    asyncio.create_task(daily_report())
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
